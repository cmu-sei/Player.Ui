{
  "name": "player.ui",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --configuration coverage",
    "lint": "ng lint",
    "docker:build": "docker build -t cmusei/player-ui:${npm_package_version} .",
    "docker:init": "docker network create identity --driver=overlay",
    "docker:stack": "npm run docker:stack:api && npm run docker:stack:identity",
    "docker:stack:proxy": "docker stack deploy -c ./docker/docker-compose.yml -c ./docker/compose/api.yml -c ./docker/api-proxy.yml player_stack",
    "docker:stack:api": "docker stack deploy -c ./docker/docker-compose.yml -c ./docker/compose/api.yml player_stack",
    "docker:stack:identity": "docker stack deploy -c ./docker/docker-compose.yml -c ./docker/compose/identity.yml identity_stack",
    "docker:destroy": "docker stack rm player_stack identity_stack",
    "swagger:gen": "curl --insecure http://localhost:4300/swagger/v1/swagger.json --output swagger.json && node_modules/@openapitools/openapi-generator-cli/bin/openapi-generator generate -i ./swagger.json -g typescript-angular -o src/app/generated/player-api --additional-properties ngVersion=12.1 --additional-properties useRxJS6=true --additional-properties modelPropertyNaming=original --type-mappings=DateTime=Date --skip-validate-spec",
    "swagger:gen-docker": "cross-env-shell docker run --rm -v $INIT_CWD:/local openapitools/openapi-generator-cli:v7.15.0 generate -i http://host.docker.internal:4300/swagger/v1/swagger.json -g typescript-angular -o /local/src/app/generated/player-api --additional-properties ngVersion=12.1 --additional-properties useRxJS6=true --additional-properties modelPropertyNaming=original --type-mappings=DateTime=Date --skip-validate-spec"
  },
  "scriptComments": {
    "docker:stack": "// Runs the entire player stack",
    "docker:stack:proxy": "// Runs the entire caster player with proxy settings",
    "docker:destroy": "// Destroys the docker player, data retained"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/localize": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@cmusei/crucible-common": "0.8.0",
    "@datorama/akita": "^8.0.1",
    "@datorama/akita-ng-router-store": "^8.0.0",
    "@mdi/font": "^7.4.47",
    "@microsoft/signalr": "^10.0.11",
    "@popperjs/core": "^2.11.8",
    "angular-resizable-element": "^8.0.3",
    "babel-polyfill": "^6.26.0",
    "bootstrap": "^5.3.8",
    "core-js": "^3.51.0",
    "font-awesome": "^4.7.0",
    "ng-table-virtual-scroll": "^1.6.1",
    "ngx-clipboard": "^16.0.0",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "^7.8.2",
    "rxjs-compat": "^6.6.7",
    "tether": "^3.0.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.28",
    "@angular-devkit/schematics": "^21.2.28",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@datorama/akita-ngdevtools": "^7.0.0",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^7.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tslib": "^2.8.1"
  }
}
